.setup-page { min-height: 100vh; padding: 34rpx 30rpx 54rpx; box-sizing: border-box; background: #f5f1e8; color: #283f40; }
.setup-header { display: flex; align-items: center; padding-bottom: 28rpx; border-bottom: 1rpx solid #d9ddd3; }
.brand { width: 68rpx; height: 68rpx; display: flex; align-items: center; justify-content: center; flex: 0 0 68rpx; border-radius: 20rpx; background: #b9dcd1; color: #283f40; font-family: serif; font-size: 32rpx; font-weight: 700; }
.header-copy { min-width: 0; margin-left: 18rpx; }.brand-name, .brand-en { display: block; white-space: nowrap; }.brand-name { font-family: serif; font-size: 34rpx; font-weight: 600; }.brand-en { margin-top: 5rpx; color: #8a9a92; font-size: 15rpx; letter-spacing: 3rpx; }
.intro { padding: 54rpx 0 34rpx; }.eyebrow { color: #8a9a92; font-size: 18rpx; font-weight: 700; letter-spacing: 4rpx; }.intro-title { display: block; margin-top: 10rpx; font-family: serif; font-size: 48rpx; font-weight: 600; }.intro-note { display: block; margin-top: 12rpx; color: #80928a; font-size: 21rpx; line-height: 1.6; }
.setup-card { border: 1rpx solid #d8dfd5; border-radius: 24rpx; background: #fffdf7; box-shadow: 0 10rpx 26rpx rgba(70, 91, 80, .06); }.date-card { padding: 24rpx; }.card-label { display: block; color: #71857c; font-size: 20rpx; }.date-picker { display: flex; align-items: center; justify-content: space-between; margin-top: 12rpx; padding: 20rpx; border-radius: 16rpx; background: #eef5ed; color: #426b64; font-size: 27rpx; font-weight: 600; }.picker-arrow { color: #719b8c; font-size: 34rpx; }
.upload-card { display: flex; align-items: center; flex-direction: column; margin-top: 20rpx; padding: 46rpx 28rpx 34rpx; text-align: center; }.upload-icon { width: 76rpx; height: 76rpx; display: flex; align-items: center; justify-content: center; border-radius: 22rpx; background: #d8ebe1; color: #508b7d; font-size: 48rpx; line-height: 1; }.upload-title { margin-top: 24rpx; font-family: serif; font-size: 34rpx; font-weight: 600; }.upload-note { margin-top: 8rpx; color: #80928a; font-size: 21rpx; }.upload-button { width: 100%; margin-top: 30rpx; padding: 22rpx; border-radius: 16rpx; background: #508b7d; color: #fffdf7; font-size: 24rpx; }.file-status { margin-top: 16rpx; color: #508b7d; font-size: 20rpx; }.small-note { max-width: 560rpx; margin-top: 18rpx; color: #97a59d; font-size: 18rpx; line-height: 1.6; }
.steps { display: flex; align-items: center; margin: 28rpx 4rpx 0; color: #71857c; font-size: 18rpx; }.step { display: flex; align-items: center; flex-direction: column; gap: 9rpx; white-space: nowrap; }.step-number { width: 38rpx; height: 38rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #d8ebe1; color: #508b7d; font-weight: 700; }.step-line { height: 1rpx; flex: 1; margin: 0 10rpx 28rpx; background: #c8d8cf; }.clear-button { width: calc(100% - 8rpx); margin: 38rpx 4rpx 0; padding: 20rpx; box-sizing: border-box; border: 2rpx solid #bf7f72; border-radius: 16rpx; background: #fffdf7; color: #a75f55; font-size: 21rpx; }
