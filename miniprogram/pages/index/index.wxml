<view class="page">
  <view class="topbar"><view class="brand">松</view><view class="brand-copy"><text class="brand-name">松课</text><text class="brand-en">A CALMER WAY TO PLAN</text></view><view class="topbar-spacer"></view><button class="gear" bindtap="openSetup">设置</button></view>
  <view class="hero"><text class="eyebrow">当前学期</text><text class="hero-title">{{semester}}</text><text class="hero-note">{{courses.length ? '课表已准备好，今天也按自己的节奏来。' : '还没有课程，请先配置教务系统。'}}</text></view>
  <view class="weekbar"><view class="week-nav"><button class="arrow" bindtap="previousWeek">‹</button><view class="week-info"><text class="week-title">第 {{week}} 周</text><text class="week-range">{{weekDays[0].date}} — {{weekDays[6].date}}</text></view><button class="arrow" bindtap="nextWeek">›</button></view><button class="today" bindtap="goToday">今天</button></view>
  <view class="calendar {{calendarTransition}}" bindtouchstart="onCalendarTouchStart" bindtouchend="onCalendarTouchEnd"><view class="time-col"><view class="corner">节次</view><block wx:for="{{sections}}" wx:key="number"><view class="time-cell"><text class="time-num">{{item.number}}</text><text>{{item.time}}</text></view><view wx:if="{{item.break}}" class="break"></view></block></view><block wx:for="{{weekDays}}" wx:key="date"><view class="day-col"><view class="day-head {{item.selected ? 'active' : ''}}"><text>周{{item.label}}</text><text class="day-date">{{item.shortDate}}</text></view><view class="slots"><block wx:for="{{sections}}" wx:key="number"><view class="slot"></view><view wx:if="{{item.break}}" class="break"></view></block><block wx:for="{{item.courses}}" wx:key="id"><view class="course tone-{{item.tone}}" data-course="{{item}}" bindtap="openCourse" style="top:{{item.top}}rpx;height:{{item.height}}rpx"><text class="course-name">{{item.name}}</text><text class="course-time">{{item.startTime}} - {{item.endTime}}</text><text class="course-meta">{{item.classroom || '地点待定'}}</text><text class="course-meta">{{item.teacher || '教师待定'}}</text></view></block></view></view></block></view>
  <view class="footer"><view class="dot"></view><text>本周 {{weekCourseCount}} 条安排 · {{todaySummary}}</text></view>
  <view wx:if="{{selectedCourse}}" class="modal-backdrop" catchtap="closeCourse"><view class="course-modal tone-{{selectedCourse.tone}}" catchtap="noop"><view class="modal-top"><text class="modal-kicker">COURSE DETAILS</text><button class="modal-close" catchtap="closeCourse">×</button></view><text class="modal-title">{{selectedCourse.name}}</text><text class="modal-code">{{selectedCourse.code || '课程编号未提供'}}</text><view class="modal-grid"><view><text>上课日期</text><text class="modal-value">{{selectedCourse.classDate}}</text></view><view><text>上课星期</text><text class="modal-value">周{{labels[selectedCourse.weekday - 1]}}</text></view><view><text>上课节次</text><text class="modal-value">第 {{selectedCourse.startSection}}-{{selectedCourse.endSection}} 节</text></view><view><text>上课时间</text><text class="modal-value">{{selectedCourse.startTime}} - {{selectedCourse.endTime}}</text></view><view><text>上课周次</text><text class="modal-value">第 {{selectedCourse.weeks[0]}}-{{selectedCourse.weeks[selectedCourse.weeks.length - 1]}} 周</text></view><view><text>上课地点</text><text class="modal-value">{{selectedCourse.classroom || '地点待定'}}</text></view><view><text>任课教师</text><text class="modal-value">{{selectedCourse.teacher || '教师待定'}}</text></view><view><text>课程性质</text><text class="modal-value">{{selectedCourse.category || '课程'}}</text></view></view></view></view>
</view>
