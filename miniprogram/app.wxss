page {
  background: #f5f1e8;
  color: #283f40;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

button { margin: 0; padding: 0; border: 0; border-radius: 0; background: transparent; line-height: normal; }
button::after { border: 0; }
.page { min-height: 100vh; padding: 28rpx 30rpx 44rpx; box-sizing: border-box; }
.topbar { display: flex; align-items: center; padding-bottom: 26rpx; border-bottom: 1rpx solid #d9ddd3; }
.brand { width: 70rpx; height: 70rpx; display: flex; align-items: center; justify-content: center; border-radius: 22rpx 22rpx 28rpx 28rpx; background: #b9dcd1; color: #283f40; font-family: serif; font-size: 32rpx; font-weight: 600; transform: rotate(-3deg); }
.brand-copy { margin-left: 18rpx; }.brand-copy text { display: block; }.brand-name { font-family: serif; font-size: 34rpx; font-weight: 600; }.brand-en { margin-top: 4rpx; color: #8a9a92; font-size: 16rpx; letter-spacing: 3rpx; }
.topbar-spacer { flex: 1; }.gear { width: 68rpx; height: 68rpx; border: 1rpx solid #b9cfc6; border-radius: 18rpx; color: #4d726d; font-size: 36rpx; }
.eyebrow { color: #8a9a92; font-size: 18rpx; font-weight: 700; letter-spacing: 4rpx; }.hero { padding: 52rpx 0 38rpx; }.hero-title { display: block; margin-top: 8rpx; font-family: serif; font-size: 58rpx; font-weight: 600; }.hero-note { display: block; margin-top: 12rpx; color: #80928a; font-size: 22rpx; }
.weekbar { display: flex; align-items: center; margin-bottom: 22rpx; }.arrow { width: 66rpx; height: 66rpx; border: 1rpx solid #bfd3ca; border-radius: 18rpx; color: #4f7972; font-size: 34rpx; }.week-info { flex: 1; padding: 0 20rpx; }.week-title { display: block; font-family: serif; font-size: 34rpx; font-weight: 600; }.week-range { display: block; margin-top: 5rpx; color: #8a9a92; font-size: 19rpx; }.today { padding: 18rpx 20rpx; border-radius: 16rpx; background: #d8ebe1; color: #4a716a; font-size: 20rpx; }
.calendar { display: flex; overflow: hidden; border: 1rpx solid #d5ddd4; border-radius: 24rpx; background: #fffdf7; box-shadow: 0 12rpx 34rpx rgba(70, 91, 80, .07); }.time-col { width: 76rpx; flex: none; }.day-col { position: relative; min-width: 0; flex: 1; border-left: 1rpx solid #e4e7dd; }.day-head, .corner { height: 86rpx; box-sizing: border-box; border-bottom: 1rpx solid #dfe5dc; }.corner { display: flex; align-items: center; justify-content: center; color: #8a9a92; font-size: 18rpx; }.day-head { display: flex; align-items: center; justify-content: center; flex-direction: column; gap: 6rpx; color: #819189; font-size: 19rpx; }.day-head.active { background: #e1f0e7; color: #50877b; }.day-date { font-size: 18rpx; font-weight: 600; }.time-cell, .slot { height: 68rpx; box-sizing: border-box; border-bottom: 1rpx solid #ebeee6; }.time-cell { display: flex; align-items: center; justify-content: center; flex-direction: column; color: #819189; font-size: 16rpx; }.time-num { color: #567d75; font-size: 19rpx; font-weight: 700; }.break { height: 14rpx; box-sizing: border-box; border-bottom: 1rpx solid #dfe8df; background: #f6f8f1; }.slots { position: relative; }.slot { background: rgba(255, 253, 247, .7); }.course { position: absolute; left: 5rpx; right: 5rpx; z-index: 2; overflow: hidden; padding: 12rpx 8rpx; box-sizing: border-box; border-left: 5rpx solid #69a99d; border-radius: 12rpx; background: #d9eee6; }.course.tone-1 { border-color: #7d9fc0; background: #e0ebf3; }.course.tone-2 { border-color: #c08b9e; background: #f3e1e5; }.course.tone-3 { border-color: #b294c0; background: #eee4f0; }.course-name { display: block; overflow: hidden; color: #304d4b; font-family: serif; font-size: 18rpx; font-weight: 600; line-height: 1.35; white-space: nowrap; text-overflow: ellipsis; }.course-meta { display: block; overflow: hidden; margin-top: 6rpx; color: #66847b; font-size: 14rpx; white-space: nowrap; text-overflow: ellipsis; }.footer { display: flex; align-items: center; gap: 10rpx; margin-top: 22rpx; color: #80928a; font-size: 19rpx; }.dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #69a99d; }
.panel { padding: 28rpx; border: 1rpx solid #d8dfd5; border-radius: 22rpx; background: #fffdf7; }.panel + .panel { margin-top: 20rpx; }.panel-title { display: block; margin-bottom: 24rpx; font-family: serif; font-size: 32rpx; font-weight: 600; }.field { display: block; margin-top: 20rpx; color: #71857c; font-size: 20rpx; }.input, .textarea { width: 100%; margin-top: 10rpx; padding: 20rpx; box-sizing: border-box; border: 1rpx solid #c6d7ce; border-radius: 14rpx; background: #fbfcf7; color: #304d4b; font-size: 23rpx; }.textarea { min-height: 230rpx; }.primary { width: 100%; margin-top: 28rpx; padding: 22rpx; border-radius: 16rpx; background: #508b7d; color: #fffdf7; font-size: 24rpx; }.secondary { width: 100%; margin-top: 18rpx; padding: 20rpx; border: 1rpx solid #b7d0c5; border-radius: 16rpx; color: #4e776d; font-size: 22rpx; }.hint { display: block; margin-top: 12rpx; color: #97a59d; font-size: 18rpx; line-height: 1.6; }.danger { color: #bd7568; }